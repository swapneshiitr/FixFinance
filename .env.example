# FixFinance — environment configuration (copy to .env and fill in)
# .env is git-ignored; never commit real secrets (NFR3).

# --- Database ---
# For local docker-compose the api overrides host to `db`; this value is used
# when running the api outside compose (e.g. directly on the host).
DATABASE_URL=postgresql+asyncpg://fixfinance:fixfinance@localhost:5432/fixfinance

# --- LLM (provider-agnostic, via an OpenAI-compatible API) ---
# The gateway talks to ANY OpenAI-compatible endpoint — swap provider by changing
# base_url + key + model. No code change. Examples:
#   Ollama (default, local): http://localhost:11434/v1   (key = "ollama"; container uses host.docker.internal)
#   Gemini:                  https://generativelanguage.googleapis.com/v1beta/openai/  (free tier ~20 req/day)
#   Groq:                    https://api.groq.com/openai/v1
#   OpenAI:                  https://api.openai.com/v1
# Local default needs Ollama running on the host: `brew services start ollama`
# then `ollama pull qwen2.5:7b && ollama pull nomic-embed-text`.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
MODEL_MAIN=qwen2.5:7b
MODEL_JUDGE=qwen2.5:7b

# --- Embeddings (provider-agnostic) ---
EMBEDDINGS_PROVIDER=ollama          # "ollama" | "gemini" | "local"
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIM=768                  # nomic-embed-text = 768; change DDL if this changes

# --- Auth (temporary, admin-provisioned; FR4.6) ---
ADMIN_KEY=change-me-admin-key
SESSION_SECRET=change-me-session-secret

# --- Orchestration ---
MAX_REPAIR=2
